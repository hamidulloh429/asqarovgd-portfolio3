# ── Database ──────────────────────────────────────────────────────────────
# Default: local SQLite file, zero config, fully persistent on disk.
DATABASE_URL="file:./dev.db"
# For production with Postgres (e.g. Supabase, Neon, Railway, RDS), swap to:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma

# ── Auth ──────────────────────────────────────────────────────────────────
# Long random string used to sign admin session JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-string"

# Admin login credentials, used only by `prisma/seed.ts` to create the first
# admin account. Change these before running the seed, or change the
# password later from inside the Admin Panel.
ADMIN_EMAIL="admin@asqarovgd.com"
ADMIN_PASSWORD="change-me-before-seeding"

# ── Uploads ───────────────────────────────────────────────────────────────
# Files are uploaded to Vercel Blob storage (not the local filesystem), since
# Vercel's serverless functions run on a read-only, ephemeral filesystem.
# This token is created automatically when you connect a Blob store to your
# Vercel project (Storage → your Blob store → Projects → Connect Project).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Max upload size per file, in megabytes.
MAX_UPLOAD_MB=200

# ── Site ──────────────────────────────────────────────────────────────────
# Public base URL, used for metadata / Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
